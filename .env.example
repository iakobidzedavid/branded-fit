# Supabase — required for analytics, brand caching, store metadata
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brandfetch — Pipeline 1 (brand extraction)
# Without this, pipeline falls back to hash-derived colors + DiceBear logo (20% fidelity)
BRANDFETCH_API_KEY=

# Printify — Pipeline 2 (mockup validation)
# Without this, pipeline uses placeholder mockup URLs
PRINTIFY_API_KEY=

# Shopify Admin API — Pipeline 3 (storefront provisioning)
# Without these, pipeline runs in demo mode (returns a simulated .myshopify.com URL)
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_NAME=

# Admin dashboard gate (/admin/analytics)
ADMIN_PASSWORD=
